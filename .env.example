# Example environment variables for FLATRA
# Fill these in on Vercel (Project Settings > Environment Variables)

# App / build
VITE_APP_ID=
NODE_ENV=production
PORT=3000

# Security
JWT_SECRET=
COOKIE_SECRET=

# Database
DATABASE_URL=postgres://user:password@host:5432/dbname

# Supabase (if used)
SUPABASE_URL=
SUPABASE_KEY=

# OAuth / External
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Built-in forge APIs
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
