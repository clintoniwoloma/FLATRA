# Copy this to .env.production and fill values for production
NODE_ENV=production
PORT=3000

# Database - when using docker-compose the hostname is 'db'
DATABASE_URL=postgresql://flatra:changeme@db:5432/flatra

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Security
JWT_SECRET=
COOKIE_SECRET=

# OAuth / External
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Built-in forge APIs
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
